# Required: bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# Optional overrides. Defaults live in core/config.py.
# GUILD_ID=
# STAFF_LOGS_CHANNEL_ID=
# MOD_CHAT_CHANNEL_ID=
# CONTENT_CHANNEL_ID=
# REDDIT_CHANNEL_ID=
# ADMIN_ROLE_ID=
# MODERATOR_ROLE_ID=
# NEW_MEMBER_ROLE_ID=
# UNVERIFIED_ROLE_ID=
# REDDIT_NOTIFICATION_ROLE_ID=
# HADITHCRITIC_USER_ID=
# NAVID_WARNING_USER_ID=
# ROLE_SELECT_CHANNEL_ID=
# RULES_CHANNEL_URL=

# Sync slash commands to GUILD_ID only (fast). Set to 1 for a global sync.
# GLOBAL_COMMAND_SYNC=0
# LOG_LEVEL=INFO

# Owner-only /archive command. Defaults to the app owner's ID.
# OWNER_USER_ID=
# ARCHIVE_DIR=archives
# ARCHIVE_ATTACHMENT_MAX_MB=100

# Set to 0 to stop DMing the security notice to new members.
# SECURITY_NOTICE_ENABLED=1

# Required for Discord app verification; must be public https URLs.
# TERMS_OF_SERVICE_URL=
# PRIVACY_POLICY_URL=

# Base of the published policy site. Both policy URLs derive from this, so
# renaming the repository is a one-value change.
# LEGAL_SITE_BASE_URL=https://hadithcritic.github.io/19--Bot
